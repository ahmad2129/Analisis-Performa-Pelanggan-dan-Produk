    <worksheet name='disc_marg_cat'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='8'>Hubungan Kategori Diskon Dengan Margin Keuntungan Setiap Kategori</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Sample - Superstore Clean Dataset)' name='federated.0scnxi811fa0ki148nz5v02ebgmk' />
          </datasources>
          <datasource-dependencies datasource='federated.0scnxi811fa0ki148nz5v02ebgmk'>
            <column caption='Total Keuntungan' datatype='real' default-format='C1033%' name='[Calculation_0783452058771456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])' />
            </column>
            <column caption='Margin Keuntungan' datatype='real' default-format='p0.00%' name='[Calculation_0783452060672004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
            </column>
            <column caption='Kategori Diskon' datatype='string' name='[Calculation_1153713334853632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Discount] &gt; 0.3 THEN &quot;&gt; 30%&quot; &#13;&#10;ELSEIF [Discount] &gt; 0.2 AND [Discount] &lt;= 0.3 THEN &quot;21% - 30%&quot;&#13;&#10;ELSEIF [Discount] &gt; 0.1 AND [Discount] &lt;= 0.2 THEN &quot;11% - 20%&quot;&#13;&#10;ELSEIF [Discount] &gt; 0 AND [Discount] &lt;= 0.1 THEN &quot;1% - 10%&quot;&#13;&#10;ELSE &quot;0&quot;&#13;&#10;END' />
            </column>
            <column caption='LOOKUP([Margin Keuntungan], 0)' datatype='real' name='[Calculation_1235352306200576]' role='measure' type='quantitative' user:unnamed='disc_marg_cat'>
              <calculation class='tableau' formula='LOOKUP([Calculation_0783452060672004], 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='LOOKUP([Total Keuntungan], 0)' datatype='real' name='[Calculation_1235352306556931]' role='measure' type='quantitative' user:unnamed='disc_marg_cat'>
              <calculation class='tableau' formula='LOOKUP([Calculation_0783452058771456], 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Kategori' datatype='string' name='[Category (copy)_1153713340968961]' role='dimension' type='nominal'>
