      <column caption='Total Keuntungan' datatype='real' default-format='C1033%' name='[Calculation_0783452058771456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])' />
      </column>
      <column caption='Total Penjualan' datatype='real' default-format='C1033%' name='[Calculation_0783452059824129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='Total Pesanan' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0783452060082179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID (copy)_0783452060045314])' />
      </column>
      <column caption='Margin Keuntungan' datatype='real' default-format='p0.00%' name='[Calculation_0783452060672004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Kategori Diskon' datatype='string' name='[Calculation_1153713334853632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] &gt; 0.3 THEN &quot;&gt; 30%&quot; &#13;&#10;ELSEIF [Discount] &gt; 0.2 AND [Discount] &lt;= 0.3 THEN &quot;21% - 30%&quot;&#13;&#10;ELSEIF [Discount] &gt; 0.1 AND [Discount] &lt;= 0.2 THEN &quot;11% - 20%&quot;&#13;&#10;ELSEIF [Discount] &gt; 0 AND [Discount] &lt;= 0.1 THEN &quot;1% - 10%&quot;&#13;&#10;ELSE &quot;0&quot;&#13;&#10;END' />
      </column>
      <column caption='Kategori' datatype='string' name='[Category (copy)_1153713340968961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Category]' />
